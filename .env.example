# Copy to .env and fill in the blanks. Never commit .env.
#
#   cp .env.example .env
#
# Generate each secret separately with:
#   openssl rand -hex 32
#
# This file IS committed, so it must never contain real secret values.

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
PUBLIC_URL=http://localhost:5000

# Comma-separated allowed browser origins.
# Under the BFF architecture the browser never calls this API directly,
# so only the Next.js server origin belongs here.
# See docs/01-ARCHITECTURE.md ADR-001.
CORS_ORIGINS=http://localhost:3000

# Number of trusted reverse-proxy hops immediately in front of the API.
# Use 1 when Next.js is the direct trusted proxy; keep 0 for direct exposure.
TRUSTED_PROXY_HOPS=0

# API documentation is enabled automatically outside production. Set this to
# true explicitly when the production Swagger UI must be publicly available.
SWAGGER_ENABLED=false

# ─── Database ──────────────────────────────────────────────────
# Dev DB on 5435, test DB on 5434 (5432 = native Postgres, 5433 = another project).
DATABASE_URL=postgresql://user:password@localhost:5435/bj_spades?schema=public

# ─── JWT ───────────────────────────────────────────────────────
# Must be two DIFFERENT 64-character hex values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Player sessions are cryptographically separate from administrator sessions.
PLAYER_JWT_ACCESS_SECRET=replace-with-a-separate-player-access-secret
PLAYER_JWT_REFRESH_SECRET=replace-with-a-separate-player-refresh-secret
PLAYER_ACCESS_TOKEN_EXPIRES=15m
PLAYER_REFRESH_TOKEN_EXPIRES=7d
PLAYER_SESSION_EXPIRES=30d
PLAYER_APP_URL=http://localhost:5173
PLAYER_APP_ORIGINS=http://localhost:5173,http://127.0.0.1:4173

# Use console only for local development. Production must use resend.
PLAYER_EMAIL_DELIVERY_MODE=console
RESEND_API_KEY=
PLAYER_EMAIL_FROM=no-reply@example.com

# Optional OAuth providers. Their buttons return a clear configuration error
# until the matching id and secret are supplied.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Webhooks ──────────────────────────────────────────────────
# Shared out of band with the external signup site.
# See docs/specs/WEBHOOK-CONTRACT.md
WEBHOOK_SECRET=

# Static bearer token for POST /api/webhooks/ghl/user-registration.
#
# GoHighLevel workflows send only static values and merge fields, so they cannot
# compute the HMAC above. Leave this EMPTY to keep that endpoint disabled — the
# guard fails closed. Minimum 16 characters when set; use `openssl rand -hex 32`.
GHL_WEBHOOK_TOKEN=

# Turns the bearer check off entirely, leaving that endpoint open to anyone who
# knows the URL. Rate limiting still applies and webhook users land in PENDING,
# but the dashboard fills with whatever is posted. TEMPORARY ONLY — an escape
# hatch for onboarding a sender that cannot send the header yet. Every admitted
# request logs a warning. Unset it (or `false`) to close the endpoint again;
# that is a restart, not a redeploy.
GHL_WEBHOOK_AUTH_DISABLED=false

# ─── File storage (Phase 4) ────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── Cloudinary (optional — unused in Milestone 1, see ADR-003) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Stripe (Phase 6 — test keys only) ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Disables rate limiting. Integration tests only — never set in dev or prod.
THROTTLE_DISABLED=false
