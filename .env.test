# Environment for `pnpm run test:integration`.
#
# Points at the disposable container defined in docker-compose.test.yml (port
# 5434). Committed on purpose: it contains no real secrets, and every developer
# and CI run needs identical values.

NODE_ENV=test
PORT=5001
PUBLIC_URL=http://localhost:5001
CORS_ORIGINS=

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/bjspades_test?schema=public

# Test-only values. Never used outside the test database.
JWT_ACCESS_SECRET=test_access_secret_0123456789abcdef
JWT_REFRESH_SECRET=test_refresh_secret_fedcba9876543210
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

WEBHOOK_SECRET=test_webhook_secret_0123456789abcdef
GHL_WEBHOOK_TOKEN=test_ghl_token_0123456789abcdef

UPLOAD_DIR=./uploads-test

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
