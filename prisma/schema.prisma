generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  /// Registered but dormant.
  INACTIVE
  /// Created by webhook, awaiting admin activation.
  PENDING
  SUSPENDED
  /// Soft-deleted. The row survives so financial history stays intact.
  DELETED
}

/// Player tier. Surfaced as the "Role" dropdown in the create-user modal.
enum UserTier {
  PLAYER
  PREMIUM
  VIP
}

enum UserSource {
  ADMIN
  WEBHOOK
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
}

enum TournamentStatus {
  SCHEDULED
  REGISTERING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  WITHDRAWN
  DISQUALIFIED
}

enum PayoutStatus {
  PENDING
  PENDING_REVIEW
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutMethod {
  STRIPE_CONNECT
  MANUAL
  // Added for the Methods tab. Additive only: removing a member would break
  // every existing row. Recording that a player connected one of these does
  // NOT mean the platform can settle over it — see PayoutMethodAccount.
  ZELLE
  ACH
  VENMO
  CASH_APP
  USDC
  BITCOIN
  ETHEREUM
  SOLANA
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ENTRY_FEE
  PRIZE
  ADJUSTMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum StripeAccountStatus {
  NOT_CONNECTED
  PENDING
  VERIFIED
  RESTRICTED
}

/// Shared by Reward and Merchandise — both surface the same three states in
/// their create modals.
enum ItemStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum RewardCategory {
  GENERAL
  FOOD
  ENTERTAINMENT
  SHOPPING
  TECH
  TRAVEL
}

enum ActivityCategory {
  AUTH
  USER
  ADMIN
  TOURNAMENT
  REWARD
  MERCHANDISE
  PAYOUT
  SETTINGS
  SECURITY
  WEBHOOK
}

model Role {
  id String @id @default(uuid())

  name String @unique

  displayName String

  description String?

  isSystem Boolean @default(false)

  admins Admin[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Permission {
  id String @id @default(uuid())

  name        String
  code        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Admin {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email    String @unique
  password String

  isActive Boolean @default(true)

  lastLogin DateTime?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens RefreshToken[]
  sessions      Session[]

  createdUsers User[]

  activityLogs ActivityLog[]

  uploadedMedia        MediaAsset[]
  createdTournaments   Tournament[]
  createdRewards       Reward[]
  createdMerchandise   Merchandise[]
  processedPayouts     Payout[]
  createdTransactions  Transaction[]
  updatedSettings      Settings[]
  securityAlerts       SecurityAlert[]
  resolvedAlerts       SecurityAlert[]      @relation("SecurityAlertResolvedBy")
  reviewedClaims       PrizeClaim[]
  resolvedDisputes     Dispute[]
  checkedVerifications PlayerVerification[]
  createdShipments     Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// A login session. This is the unit of revocation: revoking a Session
/// cascades to every RefreshToken in its rotation chain.
model Session {
  id String @id @default(uuid())

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  device    String?
  browser   String?
  os        String?
  ipAddress String?
  userAgent String?

  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())

  revokedAt DateTime?
  /// Admin id that revoked it, or null when the admin revoked their own.
  revokedBy String?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId, isActive])
  @@index([expiresAt])
}

/// Refresh tokens are stored as SHA-256 hashes, never in plaintext, and are
/// rotated on every use. Presenting an already-revoked token means it was
/// stolen, so the whole session is revoked.
model RefreshToken {
  id String @id @default(uuid())

  /// sha256(token) — the raw token is never persisted.
  tokenHash String @unique

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  adminId String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  /// Points at the token that superseded this one during rotation.
  replacedByTokenId String?
  createdByIp       String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([adminId, revokedAt])
  @@index([expiresAt])
}

model User {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email String  @unique
  phone String? @unique

  /// Collected by the create-user modal and by the registration webhook.
  /// Nullable because the webhook payload may omit them. Needed later for
  /// merchandise fulfilment.
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  /// NUMERIC, never a float — floating-point money produces rounding errors
  /// that surface as accounting discrepancies.
  balance Decimal @default(0) @db.Decimal(18, 2)

  status UserStatus @default(ACTIVE)
  tier   UserTier   @default(PLAYER)
  source UserSource

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // Stripe Connect — Phase 6
  stripeConnectAccountId String?             @unique
  stripeAccountStatus    StripeAccountStatus @default(NOT_CONNECTED)

  /// When Stripe FIRST reported this account as VERIFIED, set by the
  /// account.updated webhook. Stamped once: re-verification after a
  /// restriction must not move it, because "verified since" is the question
  /// this answers. Null for anyone never verified.
  stripeVerifiedAt DateTime?

  /// Last time this record was touched by an admin or webhook action. NOT a
  /// presence signal — there is no player app reporting online status.
  /// See docs/05-DEFERRED-SCOPE.md D-02.
  lastActiveAt DateTime?

  // Audit
  createdByAdminId String?
  createdByAdmin   Admin?  @relation(fields: [createdByAdminId], references: [id])

  /// Set when this user arrived through the registration webhook.
  webhookEventId String?       @unique
  webhookEvent   WebhookEvent? @relation(fields: [webhookEventId], references: [id])

  registrations  TournamentRegistration[]
  payouts        Payout[]
  transactions   Transaction[]
  securityAlerts SecurityAlert[]
  prizeClaims    PrizeClaim[]
  disputes       Dispute[]
  verification   PlayerVerification?
  payoutMethods  PayoutMethodAccount[]
  taxDocuments   TaxDocument[]
  shipments      Shipment[]

  /// Soft delete. Hard-deleting a user referenced by transactions or
  /// tournament registrations would destroy financial history.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tier])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([email, status])
}

/// Every inbound webhook is recorded before processing begins, so a payload
/// that fails validation can still be inspected and replayed instead of
/// vanishing. `eventId` being unique makes idempotency a database guarantee
/// rather than application logic.
model WebhookEvent {
  id String @id @default(uuid())

  /// Idempotency key supplied by the sender (X-BJS-Event-Id).
  eventId String @unique
  source  String
  type    String

  /// Raw body exactly as received, kept even when processing fails.
  payload Json
  headers Json?

  status WebhookEventStatus @default(RECEIVED)

  errorMessage String?
  attempts     Int     @default(1)

  processedAt DateTime?
  user        User?

  receivedAt DateTime @default(now())

  @@index([status])
  @@index([type, receivedAt])
}

/// Append-only audit trail of admin actions.
///
/// `title` is stored pre-rendered because the activity page displays it
/// directly. Composing the sentence at write time — while the actor, target and
/// values are all in hand — is simpler and faster than reconstructing it on
/// read. The trade-off is that renaming a user does not retroactively rewrite
/// old entries, which is correct for an audit log: it records what was true at
/// the time.
model ActivityLog {
  id String @id @default(uuid())

  category ActivityCategory
  /// Stable machine code, e.g. "user.created". See common/constants/activity-actions.ts
  action   String

  title       String
  description String?

  /// SetNull, never Cascade: deleting an admin must not erase the record of
  /// what they did.
  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  entityType String?
  entityId   String?

  /// Before/after diff and other context. Passwords, tokens and hashes are
  /// stripped by a denylist before this is written.
  metadata Json?

  ipAddress String?
  userAgent String?

  isHighPriority Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([isHighPriority, createdAt])
}

/// An uploaded file, stored behind the StorageService interface.
///
/// Kept as its own model rather than a URL column so the same image can be
/// referenced by more than one entity, and so swapping local disk for
/// Cloudinary later changes only `key` and `url`.
model MediaAsset {
  id String @id @default(uuid())

  /// Storage-relative key, e.g. "tournaments/<uuid>.webp". Never the original
  /// filename — that is attacker-controlled and a path-traversal vector.
  key String @unique
  url String

  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?

  uploadedByAdminId String?
  uploadedByAdmin   Admin?  @relation(fields: [uploadedByAdminId], references: [id])

  tournaments Tournament[]
  rewards     Reward[]
  merchandise Merchandise[]

  createdAt    DateTime      @default(now())
  taxDocuments TaxDocument[]
}

model Tournament {
  id String @id @default(uuid())

  name        String
  description String?

  imageId String?
  image   MediaAsset? @relation(fields: [imageId], references: [id])

  entryFee  Decimal @default(0) @db.Decimal(18, 2)
  prizePool Decimal @default(0) @db.Decimal(18, 2)

  /// Int rather than an enum: the modal offers a fixed list (8/16/…/256) and
  /// the DTO validates membership, but a custom size must not need a migration.
  maxPlayers Int

  /// Always UTC. The modal submits a separate date and time; the DTO combines
  /// them. Interpreting them as server-local silently shifts start times.
  startsAt DateTime

  status TournamentStatus @default(SCHEDULED)

  cancelledAt  DateTime?
  cancelReason String?

  createdByAdminId String
  createdByAdmin   Admin  @relation(fields: [createdByAdminId], references: [id])

  registrations TournamentRegistration[]
  payouts       Payout[]
  transactions  Transaction[]
  prizeClaims   PrizeClaim[]
  disputes      Dispute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, startsAt])
  @@index([startsAt])
}

model TournamentRegistration {
  id String @id @default(uuid())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status RegistrationStatus @default(REGISTERED)

  /// Final rank and prize, set when results are submitted.
  placement Int?
  prizeWon  Decimal? @db.Decimal(18, 2)

  registeredAt DateTime @default(now())

  /// Payout associated with this registration
  payout   Payout? @relation(fields: [payoutId], references: [id])
  payoutId String?

  /// Makes double-registration impossible at the database level rather than
  /// relying on a check-then-insert race in application code. Two simultaneous
  /// registrations for the last slot are resolved here, not by luck.
  @@unique([tournamentId, userId])
  @@index([userId])
  @@index([tournamentId, status])
}

model Reward {
  id String @id @default(uuid())

  name     String
  company  String
  category RewardCategory @default(GENERAL)

  /// Deliberately a display STRING, not a Decimal. The existing data mixes
  /// currency ("$20") with token counts ("100"), so a numeric column would need
  /// a companion unit enum and a change to the reward modal — neither is in
  /// Milestone 1. Recorded as accepted debt: docs/05-DEFERRED-SCOPE.md D-17.
  value String

  description String?
  terms       String?

  imageId String?
  image   MediaAsset? @relation(fields: [imageId], references: [id])

  status ItemStatus @default(ACTIVE)

  /// null means unlimited — correct for a digital gift-card code.
  stock         Int?
  /// Reserved for Milestone 2 redemption; stays 0 for now.
  redeemedCount Int  @default(0)

  createdByAdminId String
  createdByAdmin   Admin  @relation(fields: [createdByAdminId], references: [id])

  /// Soft delete: a reward someone has redeemed cannot be erased without
  /// breaking history, even though redemption does not exist yet.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, category])
  @@index([deletedAt])
  @@index([createdAt])
}

model Merchandise {
  id String @id @default(uuid())

  name        String
  description String?

  /// Money is NUMERIC and formatted at the display layer. The mock showed
  /// "$39.95" as a string; storing it that way makes arithmetic impossible.
  price Decimal @db.Decimal(18, 2)

  imageId String?
  image   MediaAsset? @relation(fields: [imageId], references: [id])

  status ItemStatus @default(ACTIVE)

  variants MerchandiseVariant[]

  createdByAdminId String
  createdByAdmin   Admin  @relation(fields: [createdByAdminId], references: [id])

  deletedAt DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]

  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

model MerchandiseVariant {
  id String @id @default(uuid())

  merchandiseId String
  merchandise   Merchandise @relation(fields: [merchandiseId], references: [id], onDelete: Cascade)

  size  String?
  color String?

  /// Optional, but unique when supplied. Auto-generated when omitted.
  sku   String? @unique
  stock Int     @default(0)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shipments Shipment[]

  @@index([merchandiseId])
}

model Payout {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount   Decimal      @db.Decimal(18, 2)
  currency String       @default("usd")
  method   PayoutMethod @default(STRIPE_CONNECT)
  status   PayoutStatus @default(PENDING)

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  placement    Int?

  stripeTransferId String? @unique
  failureReason    String?
  blockerReason    String? // "KYC incomplete", "Wallet unverified"

  owedSince   DateTime  @default(now())
  approvedAt  DateTime?
  processedAt DateTime?
  paidAt      DateTime?

  /// When Stripe confirmed the transfer SETTLED (transfer.paid).
  ///
  /// `paidAt` is when the transfer was created and Stripe accepted it; this is
  /// when the money actually landed. Deliberately never backfilled from
  /// `paidAt` — doing so would assert a settlement nobody observed. Null until
  /// Stripe says so.
  settledAt DateTime?

  approvedByAdminId String?
  approvedByAdmin   Admin?  @relation(fields: [approvedByAdminId], references: [id])

  transactions Transaction[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tournamentRegistrations TournamentRegistration[]

  @@index([status, owedSince])
  @@index([userId])
}

model Transaction {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type   TransactionType
  status TransactionStatus @default(PENDING)

  amount        Decimal @db.Decimal(18, 2) // signed: negative = debit
  balanceBefore Decimal @db.Decimal(18, 2)
  balanceAfter  Decimal @db.Decimal(18, 2)

  description String?
  reference   String? @unique // external id, e.g. Stripe

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  createdByAdminId String?
  createdByAdmin   Admin?  @relation(fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([createdAt])
}

model Settings {
  id String @id @default(uuid())

  /// Settings key (company, adminEmail, timezone, etc.)
  key String @unique

  /// JSON value for the setting
  value Json

  /// Human-readable description of the setting
  description String?

  /// Settings category for grouping
  category String @default("general")

  /// Whether this setting requires admin permission to change
  isProtected Boolean @default(false)

  /// Admin who last updated this setting
  updatedByAdminId String?
  updatedByAdmin   Admin?  @relation(fields: [updatedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isProtected])
}

model SecurityAlert {
  id String @id @default(uuid())

  title       String
  description String
  severity    String // HIGH, MEDIUM, LOW
  status      String @default("UNRESOLVED") // UNRESOLVED, INVESTIGATING, RESOLVED

  /// IP address or other identifier related to the alert
  sourceIp  String?
  userAgent String?

  /// User or admin this alert relates to
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id])

  /// Additional metadata about the alert
  metadata Json?

  /// When the alert was resolved
  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedByAdmin   Admin?    @relation("SecurityAlertResolvedBy", fields: [resolvedByAdminId], references: [id])

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([sourceIp])
}

/// Where a player's claim sits in the review queue.
enum ClaimStatus {
  PENDING_REVIEW
  APPROVED
  DECLINED
}

/// A player's claim on a prize they placed for.
///
/// Separate from `Payout`: a claim is the player asserting a right to
/// something, which an admin then accepts or refuses. The payout is what
/// happens after an approval, and plenty of claims never become one.
model PrizeClaim {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  placement Int?

  /// What was claimed, in words: "$1,000 + Hoodie". Free text because a prize
  /// is not always money and the merchandise link does not exist yet.
  prizeDescription String

  /// The money part, where there is one. Null for a purely physical prize.
  prizeAmount Decimal? @db.Decimal(18, 2)

  /// The player accepted the prize terms. False is a real blocker, not a
  /// formality — an unaccepted claim must not be approved.
  termsAccepted Boolean @default(false)

  /// A shipping address exists for the physical part of the prize.
  shippingProvided Boolean @default(false)

  status      ClaimStatus @default(PENDING_REVIEW)
  submittedAt DateTime    @default(now())

  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewedByAdmin   Admin?    @relation(fields: [reviewedByAdminId], references: [id])

  /// Required when declining, so a refusal always carries a reason.
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, submittedAt])
  @@index([userId])
}

enum DisputeRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DisputeStatus {
  UNDER_REVIEW
  CLEARED
  DISQUALIFIED
  APPEAL_FILED
}

/// An anti-cheat case or a player-filed appeal.
model Dispute {
  id String @id @default(uuid())

  /// Human-facing case reference, e.g. DSP-4471. Unique so it can be searched
  /// and quoted to a player.
  caseNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id])

  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])

  /// The match this concerns, where it is about one. Free text: matches are
  /// not modelled in this milestone.
  matchReference String?

  reason String
  risk   DisputeRisk   @default(LOW)
  status DisputeStatus @default(UNDER_REVIEW)

  filedAt DateTime @default(now())

  resolvedAt        DateTime?
  resolvedByAdminId String?
  resolvedByAdmin   Admin?    @relation(fields: [resolvedByAdminId], references: [id])

  /// Why it was cleared or disqualified. Required on resolution — a
  /// disqualification with no stated reason cannot be defended later.
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, filedAt])
  @@index([risk, status])
  @@index([userId])
}

enum SponsorStatus {
  ACTIVE
  PENDING
  INACTIVE
}

/// A sponsor and the prize they fund.
model Sponsor {
  id String @id @default(uuid())

  name String

  /// What the sponsor provides: "$2,000 bonus + branded swag".
  prizeDescription String

  /// Cash value of the sponsorship.
  value Decimal @db.Decimal(18, 2)

  /// How the arrangement works — "10% affiliate", "Promo codes",
  /// "Sponsored payout". Free text: these are commercial terms, not a fixed
  /// set the software should pretend to enumerate.
  splitType String

  contactEmail String

  status SponsorStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, name])
}

/// One verification check's outcome.
///
/// `PENDING` is "not looked at yet"; `NOT_REQUIRED` is a deliberate decision
/// that this check does not apply (a non-US player has no W9 to file). They are
/// different states and must not be collapsed.
enum VerificationCheckState {
  PENDING
  PASSED
  FAILED
  NOT_REQUIRED
}

/// Per-player identity, eligibility and risk checks.
///
/// One row per user. Every check is **recorded by an admin**, not performed by
/// the platform: there is no KYC provider, no age-verification service and no
/// fraud engine wired in. This model is the record of a human decision, and the
/// UI must not present it as an automated result.
model PlayerVerification {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ISO 3166-1 alpha-2, e.g. "US". Drives country eligibility.
  country String?

  /// The wallet a crypto payout would go to. Free text: address formats differ
  /// per chain and this system validates none of them.
  walletAddress String?

  kycCheck     VerificationCheckState @default(PENDING)
  ageCheck     VerificationCheckState @default(PENDING)
  countryCheck VerificationCheckState @default(PENDING)
  taxCheck     VerificationCheckState @default(PENDING)
  walletCheck  VerificationCheckState @default(PENDING)
  fraudCheck   VerificationCheckState @default(PENDING)

  /// Free-text note from the admin who last touched this record.
  note String?

  lastCheckedAt        DateTime?
  lastCheckedByAdminId String?
  lastCheckedByAdmin   Admin?    @relation(fields: [lastCheckedByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country])
}

/// A payout rail a player has connected.
///
/// Recording an account here means the player told us where to send money. It
/// does NOT mean the platform can settle over that rail — only STRIPE_CONNECT
/// has an integration. `PayoutsService.process` still refuses anything else.
model PayoutMethodAccount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  method PayoutMethod

  /// What the player calls it: "Chase checking", "Ledger wallet".
  label String?

  /// The handle, masked account number or address. Never a full credential —
  /// this system stores no bank numbers it could be asked to protect.
  reference String

  /// An admin confirmed the destination belongs to the player.
  isVerified Boolean @default(false)

  /// Where a player has several, the one used by default.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One account per rail per player.
  @@unique([userId, method])
  @@index([userId])
}

enum TaxDocumentKind {
  W9
  W8BEN
  FORM_1099
}

enum TaxDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// A tax document captured for a player.
///
/// This is document *capture and record-keeping*. Nothing here generates a
/// legally-valid 1099 — that is a compliance product, not a feature, and the UI
/// says so rather than implying otherwise.
model TaxDocument {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind TaxDocumentKind

  /// Calendar year the document covers.
  taxYear Int

  /// The uploaded file, where one was provided.
  mediaAssetId String?
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id])

  status TaxDocumentStatus @default(PENDING)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, taxYear])
  @@index([userId])
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

/// A physical prize on its way to a player.
///
/// The destination is read from the player's address fields on `User`, which
/// the create-user modal and the registration webhook already collect — a
/// second address model would be a second thing to keep correct.
model Shipment {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  merchandiseId String
  merchandise   Merchandise @relation(fields: [merchandiseId], references: [id])

  /// The chosen size/colour, where the item has variants.
  variantId String?
  variant   MerchandiseVariant? @relation(fields: [variantId], references: [id])

  /// Personalisation the player asked for, e.g. an engraved name.
  customisation String?

  status ShipmentStatus @default(PENDING)

  carrier        String?
  trackingNumber String?

  shippedAt   DateTime?
  deliveredAt DateTime?

  createdByAdminId String?
  createdByAdmin   Admin?  @relation(fields: [createdByAdminId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// The platform's on-chain treasury balance, as recorded by an admin.
///
/// There is no chain integration: nothing here reads a block explorer or a
/// contract. `balance` is a figure an operator entered, and the UI must present
/// it as a recorded balance rather than a verified one. The prototype's "Smart
/// contract verified" badge has no contract behind it and is not rendered.
model TreasuryWallet {
  id String @id @default(uuid())

  label   String
  address String @unique

  /// "polygon", "ethereum", "solana".
  network String

  /// Ticker of what the balance is denominated in, e.g. "USDC".
  currency String

  /// Last balance an admin recorded. NOT read from chain.
  balance Decimal @default(0) @db.Decimal(36, 8)

  balanceRecordedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
